    sed -i 's|https://www.icedove.net/donate/.*"|https://trisquel.info/donate/"|'
grep -rl 'https://www.icedove.net/donate/' comm/ | xargs -r \
    sed -i 's|https://www.icedove.net/donate/|https://trisquel.info/donate/|'
