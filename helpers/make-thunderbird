    perl -0777 -i -pe 's/<!ENTITY\s+trademarkInfo\.part1\s*"(?:[^"]|\n)*">/<!ENTITY  trademarkInfo.part1   " ">/g'

##Remove invalid policy for trisquel, make sure to check for changes on
