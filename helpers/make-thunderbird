find . -type f \
    -not -iregex '.*changelog.*' \
    -not -iregex '.*copyright.*' \
    -not -iregex '.*comm/rust.*' \
    -not -iregex '.*third_party/rust.*' \
    -not -iregex '.*third_party/dump_syms.*' \
