# TPH#259: the broken utmp/wtmp (64-bit time_t transition) only affects the
# 32-bit arch. Build wtmpdb only on armhf, where the classic "last" is unusable.
# On amd64/arm64 stays as original replacing it would be a regression there.
--- a/debian/control
+++ b/debian/control
@@ -24,7 +24,7 @@
 Homepage: https://github.com/thkukuk/wtmpdb/
 
 Package: wtmpdb
-Architecture: any
+Architecture: armhf
 Priority: standard
 Replaces:
  util-linux (<< 2.40.1-3),
@@ -44,7 +44,7 @@
  login records.
 
 Package: libwtmpdb0
-Architecture: any
+Architecture: armhf
 Section: libs
 Multi-Arch: same
 Description: wtmp database shared library
@@ -54,7 +54,7 @@
  wtmpdb login and reboot records.
 
 Package: libwtmpdb-dev
-Architecture: any
+Architecture: armhf
 Section: libdevel
 Multi-Arch: same
 Depends:
@@ -66,7 +66,7 @@
  wtmpdb login and reboot records.
 
 Package: libpam-wtmpdb
-Architecture: any
+Architecture: armhf
 Priority: standard
 Depends:
  libpam-runtime,
