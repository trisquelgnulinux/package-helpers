https://git.kernel.org/torvalds/c/bea2662e7818
https://git.kernel.org/torvalds/c/353d321f63f7
https://git.kernel.org/torvalds/c/3d913719df14

diff -u a/drivers/net/wireless/intel/iwlwifi/iwl-drv.c b/drivers/net/wireless/intel/iwlwifi/iwl-drv.c
--- a/drivers/net/wireless/intel/iwlwifi/iwl-drv.c
+++ b/drivers/net/wireless/intel/iwlwifi/iwl-drv.c
@@ -1593,7 +1593,7 @@
 	u32 api_ver;
 	int i;
 	bool usniffer_images = false;
-	bool failure = true;
+	bool failure = false; /* Trisquel: no dealloc on the failure path */
 
 	iwl_get_ucode_api_versions(drv->trans, &api_min, &api_max);
 
