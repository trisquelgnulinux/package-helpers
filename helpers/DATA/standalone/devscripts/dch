# Run the debchange bundled from Trisquel's devscripts package (see SOURCE).
# Needs only perl and libdpkg-perl, which dpkg-dev already requires. Without
# them this fails, which is the intended behaviour.

here=$(dirname "$(readlink -f "$0")")

# Refuse to run if any bundled file differs from the official package, or if
# anything unlisted sits under usr/: it is first in @INC and would shadow the
# system Perl modules.
listed=$(awk '{print $2}' "$here/SHA256SUMS" | sort)
present=$(cd "$here" && find usr -type f -o -type l | sort)
if [ "$listed" != "$present" ] ||
   ! (cd "$here" && sha256sum --check --quiet --strict SHA256SUMS); then
    echo "dch (standalone): $here does not match SHA256SUMS, refusing to run" >&2
    exit 1
fi

# --vendor=Trisquel: Trisquel's debchange calls TrisquelDistroInfo, which a
# host with Ubuntu's libdistro-info-perl does not have. Fixing the vendor skips
# that lookup and matches what dch does on a Trisquel host.
exec perl -I"$here/usr/share/perl5" "$here/usr/bin/debchange" --vendor=Trisquel "$@"
