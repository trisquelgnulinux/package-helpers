diff --git a/kernel/arm64.sh b/kernel/arm64.sh
index a5a5ec4a..9d5e07b4 100644
--- a/kernel/arm64.sh
+++ b/kernel/arm64.sh
@@ -1,5 +1,8 @@
+# Adjusted for Trisquel: use 'generic' flavour on all supported architectures,
