VERSION=6
EXTERNAL='deb-src http://deb.debian.org/debian sid main'
REPOKEY=6ED0E7B82643E131
BACKPORTS=true
. ./config

SUPPORTED_SITES="https://ytdl-org.github.io/youtube-dl/supportedsites.html"
LAST_SUPPORTED="$(tail -n1 debian/control|sed 's|^ ||')"

sed -i "/Currently supported/s|are:|are at:|" debian/control
/bin/sed -n -i '/Currently supported/{p;:a;N;/'$LAST_SUPPORTED'/!ba;s| .*| '$SUPPORTED_SITES'\n|};p' debian/control
# Make sure it fails if we don't get the wanted output.
[ "$SUPPORTED_SITES" != "$(tail -n2 debian/control|awk NF|sed 's|^ ||')" ] && \
  echo -e ">>>Site replacement needs fixing, exiting...<<<\n" && exit

! grep -q "Priority:" debian/control && sed -i '/Section:/a Priority: optional' debian/control

apply_patch_changes

# yt-dlp >= 2026.10.26 requires Python 3.11, aramo ships 3.10: shim the few 3.11 APIs it uses.
sed -i '/^if sys.version_info < (3, 11):$/,/noqa: F541$/c\
if sys.version_info < (3, 11):  # Trisquel: Python 3.10 compat shims\
    import datetime, re\
    datetime.UTC = datetime.timezone.utc\
    re.NOFLAG = 0\
    sys.exception = lambda: sys.exc_info()[1]' yt_dlp/__init__.py
sed -i "s/\.to_bytes(\([0-9]\+\))/.to_bytes(\1, 'big')/g" yt_dlp/aes.py yt_dlp/extractor/abematv.py

sed -i '/python3-pytest (>= 9.0~) <!nocheck>,/d' debian/control
sed -i 's/^\tmake offlinetest PYTHON=python3$/\t: # Test suite needs pytest >= 9 and Python >= 3.11/' debian/rules

changelog "Track latest release and remove explicit site listing, redirecting to website author."

package
